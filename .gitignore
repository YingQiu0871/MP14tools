# Every generated file lives under build\ - see .cargo\config.toml, which points
# cargo's target directory at build\obj. Deleting build\ removes all of it.
build/

# Kept so that an older checkout which still has a sibling target\ directory
# does not start committing binaries.
target/

# Local install/run artifacts
eco-setup-output.txt
eco-apply.log
mp14tools.exe
check.log

*.pdb
